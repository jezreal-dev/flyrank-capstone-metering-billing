# ==============================================================================
# FlyRank Capstone — LLM Usage Metering & Billing Service
# Environment Configuration Template
# ==============================================================================

# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# SQLite Database Path
DATABASE_PATH=data/billing_engine.db

# Stripe Test Mode Configuration (Free Sandbox - No Real Money)
# Get your free test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_evaluator_run
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_signing_secret

# AI Token Pricing Constants (Integer microcents per 1,000,000 tokens)
# 1 USD = 100 cents = 100,000,000 microcents
PRICE_PER_MILLION_INPUT_MICROCENTS=15000000       # $0.150 / 1M tokens
PRICE_PER_MILLION_CACHED_INPUT_MICROCENTS=7500000 # $0.075 / 1M tokens (50% discount)
PRICE_PER_MILLION_OUTPUT_MICROCENTS=60000000      # $0.600 / 1M tokens (Reasoning tokens billed as output)

# Plan Quotas
FREE_PLAN_API_QUOTA=1000
FREE_PLAN_TOKEN_QUOTA=100000
PRO_PLAN_API_QUOTA=50000
PRO_PLAN_TOKEN_QUOTA=10000000
